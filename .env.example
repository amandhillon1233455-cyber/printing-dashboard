# GEMINI_API_KEY: Required for Gemini AI API calls and RAG assistant.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MongoDB Database configuration
MONGODB_URI="mongodb+srv://username:password@cluster0.mongodb.net/?retryWrites=true&w=majority"
DATABASE_NAME="printing_dashboard"

# n8n Automation Webhook URL (for order status notifications)
N8N_WEBHOOK_URL="https://n8n.example.com/webhook/printai-order-events"

# Application Secret & URLs
APPLICATION_SECRET="super-secret-jwt-or-api-key"
FRONTEND_URL="http://localhost:3000"

# Optional client API target (defaults to relative /api when full-stack)
VITE_API_URL="/api"
